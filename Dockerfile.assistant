FROM node:24-bookworm@sha256:2f6533894e81c654764273b03a065aa3265fa50db292ba8348b6c4bb77233e98 AS base

WORKDIR /app

FROM base AS build

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund

COPY prisma/schema.prisma ./prisma/schema.prisma
COPY prisma7.config.ts ./
RUN ./node_modules/.bin/prisma generate --config ./prisma7.config.ts

COPY nest-cli.json tsconfig.json tsconfig.build.json ./
COPY src ./src

RUN npm run build \
    && test -s dist/main.js \
    && npm prune --omit=dev --ignore-scripts --no-audit --no-fund \
    && node -e "require('@prisma/client').PrismaClient || process.exit(1)"

FROM base AS runtime

ENV NODE_ENV=production
ENV PORT=3007

COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist

USER node
EXPOSE 3007

CMD ["node", "dist/main.js"]
