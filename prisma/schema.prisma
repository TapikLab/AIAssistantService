generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ScheduledMessage {
  id        String    @id @default(uuid())
  userId    String
  chatId    String
  content   String
  sendAt    DateTime
  status    String    @default("pending")
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  @@index([status, sendAt])
}

model AutoReplySetting {
  id                 String   @id @default(uuid())
  userId             String
  chatId             String
  enabled            Boolean  @default(true)
  customInstructions String?  @db.Text
  version            Int      @default(0)
  updateAt           DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([userId])
}

enum PersonalChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model PersonalChatMessage {
  id              String            @id @default(uuid())
  userId          String
  role            PersonalChatRole
  content         String            @db.Text
  attachments     Json?
  intent          Json?
  clientMessageId String?
  createdAt       DateTime          @default(now())

  @@unique([userId, clientMessageId])
  @@index([userId, createdAt])
}

model AssistantRuleAuditLog {
  id              String   @id @default(uuid())
  userId          String
  targetChatId    String
  action          String
  payload         Json
  sourceMessageId String?
  createdAt       DateTime @default(now())

  @@index([userId, targetChatId])
}

model TrustedTeeMeasurement {
  platform     String                   @db.VarChar(16)
  measurements Bytes                    @db.ByteA
  publishedAt  DateTime                 @default(now()) @db.Timestamptz(3)
  proof        TrustedMeasurementProof?

  @@id([platform, measurements])
}

model TrustedMeasurementProof {
  platform     String @db.VarChar(16)
  measurements Bytes  @db.ByteA
  signature    Bytes  @db.ByteA

  entry TrustedTeeMeasurement @relation(fields: [platform, measurements], references: [platform, measurements], onDelete: Restrict, onUpdate: Restrict)

  @@id([platform, measurements])
}

model SnpChallenge {
  requestId         String    @id @db.Uuid
  nonce             Bytes     @db.ByteA
  keyHash           Bytes     @db.ByteA
  expiresAt         DateTime  @db.Timestamptz(6)
  consumedAt        DateTime? @db.Timestamptz(6)
  releaseEnvelope   String?   @db.Text
  releaseReportHash Bytes?    @db.ByteA

  @@index([expiresAt])
}
